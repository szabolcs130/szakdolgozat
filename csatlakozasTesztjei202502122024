class csatlakozas{
    private $host;
    private $dbname;
    private $charset;
    private $alma;
    private $korte;
    private $szilva;
    private $db;
    public $eredmeny;
    private $eleresiAdatokJok;
    public function __construct($host = "localhost",$dbname = "szakdolgozatproba",$charset = "utf8",$alma = "root",$korte = "",$szilva = 'SET NAMES utf8 COLLATE utf8_hungarian_ci') {
        $this->host = $host;
        $this->dbname = $dbname;
        $this->charset = $charset;
        $this->alma = $alma;
        $this->korte = $korte;
        $this->szilva = $szilva;
        $this->eredmeny=array();
        $this->eleresiAdatokJok=false;
        try {
            $this->db = new PDO("mysql:host={$this->host};dbname={$this->dbname};charset={$this->charset}", "{$this->alma}", "{$this->korte}"); 
            $this->db->query("{$this->szilva}"); 
            $this->eleresiAdatokJok=true;
        } catch (PDOException $e) {
            echo "Adatbazis eleres hiba: alap eleresi adatok--> ".$e->getMessage()."<br>";
        }
    }
   
    public function lekerdezAru(){
        if ($this->eleresiAdatokJok) {
            try {
                $sql = "select * from aru";
                $sth = $this->db->prepare($sql);
                $sth->execute();
                $this->eredmeny = $sth->fetchAll(PDO::FETCH_CLASS, "aru");//csak egy darab : fetch(PDO::FETCH_ASSOC);
                return $this->eredmeny;
            } catch (PDOException $e) {
                echo "Adatbazis eleres hiba: aru tabla lekerdezese--> ".$e->getMessage()."<br>";
                return -1;
            }
        }
    }
    public function lekerdezSzemely(){
        if ($this->eleresiAdatokJok) {
            try {
                $sql = "select * from szemely";
                $sth = $this->db->prepare($sql);
                $sth->execute();
                $this->eredmeny = $sth->fetchAll(PDO::FETCH_CLASS, "szemely");//csak egy darab : fetch(PDO::FETCH_ASSOC);
                return $this->eredmeny;
            } catch (PDOException $e) {
                echo "Adatbazis eleres hiba: szemely tabla lekerdezese--> ".$e->getMessage()."<br>";
                return -1;
            }
        }
    }
    public function lekerdezMenu(){
        if ($this->eleresiAdatokJok) {
            try {
                $sql = "select * from menu";
                $sth = $this->db->prepare($sql);
                $sth->execute();
                $this->eredmeny = $sth->fetchAll(PDO::FETCH_CLASS, "menu");//csak egy darab : fetch(PDO::FETCH_ASSOC);
                $menu = [];
                foreach ($this->eredmeny as $value) {
                    $menu[] = new menu($value->getId(), $value->getNev(), $value->getRang());
                }
                return $menu;
            } catch (PDOException $e) {
                echo "Adatbazis eleres hiba: menu tabla lekerdezese--> ".$e->getMessage()."<br>";
                return -1;
            }
        }
    }
    
    public function torolAru($id){
        if($this->eleresiAdatokJok){        
            try{
                $sql = "DELETE FROM `aru` WHERE id_aru=:id_aru";
                $sth = $this->db->prepare($sql);
                $sth->execute(array(":id_aru"=>$id));
                if ($sth->rowCount()) {
                    return 1;
                }else{
                    return -1;
                }
            } catch (PDOException $e) {
                echo "Adatbazis eleres hiba: Aru tablaban torles sikertelen--> ".$e->getMessage()."<br>";
                return -1;
            }
        }
    }
